#!/usr/bin/env bash
# dream_archivetool — wrapper for DreamWeave dream_archivetool (BSA/BA2 CLI; tested 1.1.0, MIT or Apache-2.0).
# Not bundled. Download dream_archivetool-Linux-X64.zip from
#   https://github.com/DreamWeave-MP/dream_archivetool/releases
# and put the binary at $DREAM_ARCHIVETOOL (default $KIT_HOME/tools/vendor/dream_archivetool/dream_archivetool).
# Prefer read-only `info` / `list` / `verify`. extract, extract-all, create and add write files:
# only on box copies, never into a live mod folder.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
KIT_HOME="${KIT_HOME:-$(cd "$HERE/../.." && pwd)}"
BIN="${DREAM_ARCHIVETOOL:-$KIT_HOME/tools/vendor/dream_archivetool/dream_archivetool}"
[[ -x "$BIN" ]] || { echo "dream_archivetool: binary missing: $BIN (see docs/OPTIONAL-CLIS.md)" >&2; exit 1; }
exec "$BIN" "$@"
