#!/usr/bin/env python3
# minimal SOCKS5 ProxyCommand replacement for nc -X 5 -x host:port
import socket,sys,struct,threading,os
ph,pp=sys.argv[1].split(':');h=sys.argv[2];p=int(sys.argv[3])
s=socket.create_connection((ph,int(pp)),timeout=20)
s.sendall(b'\x05\x01\x00');assert s.recv(2)==b'\x05\x00'
hb=h.encode();s.sendall(b'\x05\x01\x00\x03'+bytes([len(hb)])+hb+struct.pack('>H',p))
r=s.recv(10)
if len(r)<2 or r[1]!=0: sys.exit('socks fail %r'%r)
s.settimeout(None)
def up():
    while True:
        d=os.read(0,65536)
        if not d: s.shutdown(socket.SHUT_WR);break
        s.sendall(d)
threading.Thread(target=up,daemon=True).start()
while True:
    d=s.recv(65536)
    if not d: break
    os.write(1,d)
